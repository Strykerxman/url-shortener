# =============================================================================
# URL Shortener — Environment Configuration
# =============================================================================
# Copy this file to create your environment:
#
#   • Docker Compose  →  cp .env.example .env
#   • Local dev       →  cp .env.example .env.local  (overrides .env values)
#
# NEVER commit .env or .env.local — they contain real credentials.
# =============================================================================

# --- Database (PostgreSQL) ---
# For Docker Compose, "db" resolves to the Postgres container.
# For local dev, replace "db" with "localhost".
DATABASE_URL=postgresql+psycopg2://urlshortener:changeme_secure_password_123@db:5432/urlshortener_db
DATABASE_USER=urlshortener
DATABASE_PW=changeme_secure_password_123
DATABASE_NAME=urlshortener_db

# --- Application ---
BASE_URL=http://127.0.0.1:8000
DEBUG=false
ENV_NAME=production

# --- Redis ---
# For Docker Compose, "redis" resolves to the Redis container.
# For local dev, replace "redis" with "localhost".
REDIS_HOST=redis
REDIS_PORT=6379